    <string name="remote_agent_password_prefill_details">口令仅保留在手机内存中，对当前连接有效。确认页会自动填入，仍可修改，每次签名仍需手动确认。断开连接即清除。留空可清除此密钥的预填口令。</string>
    <string name="remote_agent_password_connect_first">请先连接。预填口令仅在当前连接期间有效。</string>
    <string name="remote_agent_password_saved">已更新当前连接的预填口令。</string>
    <string name="remote_agent_passwords_cleared">已清除全部预填口令。</string>
    <string name="remote_agent_approve">允许此次签名</string>
    <string name="remote_agent_deny">拒绝</string>
    <string name="remote_agent_approval_details">远端 Tailscale 节点：\n%1$s\n\n签名密钥：\n%2$s\n%3$s\n\n%5$s 摘要：\n%4$s\n\n请求由远端主机提供，手机无法独立验证引用的文件或仓库。仅确认由你发起的操作。请求最多等待 90 秒。</string>
    <string name="remote_agent_no_keys">本应用中未找到可用的本地签名私钥。请在此应用内导入签名密钥，或查看诊断日志了解原因。本预览版使用独立密钥存储。</string>
    <string name="remote_agent_reconnect">请先断开，再连接以应用设置。</string>
