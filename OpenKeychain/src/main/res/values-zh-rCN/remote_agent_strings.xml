    <string name="remote_agent_no_keys">本应用中未找到可用的本地签名私钥。请在此应用内导入签名密钥，或查看诊断日志了解原因。本预览版使用独立密钥存储。</string>
    <string name="remote_agent_reconnect">请先断开，再连接以应用设置。</string>
    <string name="remote_agent_invalid_hostname">名称以字母或数字开头，最多 63 个字母、数字或连字符。</string>
    <string name="remote_agent_invalid_control">请输入不含凭据、查询或片段的 HTTPS 服务器地址。</string>
    <string name="remote_agent_invalid_peers">请输入稳定节点 ID，多个 ID 用逗号分隔。</string>
