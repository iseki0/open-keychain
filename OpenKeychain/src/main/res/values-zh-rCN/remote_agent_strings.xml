<resources>
    <string name="remote_agent_title">Tailscale 远端签名</string>
    <string name="remote_agent_settings_summary">让 CodexCloud 使用此手机上的密钥签名</string>
    <string name="remote_agent_explanation">应用内接入 Tailscale，无需系统 VPN。Assuan 使用 tailnet 端口 17373，gpg-bridge 使用 17389。节点框留空允许全部 Tailscale 节点，填写后仅允许指定节点。可选择单个签名密钥或全选，每次签名均需手机确认。需要 Android 7 或更高版本。</string>
    <string name="remote_agent_hostname">Tailscale 设备名称</string>
    <string name="remote_agent_control">控制服务器 HTTPS 地址（留空使用 Tailscale）</string>
    <string name="remote_agent_peers">允许的稳定节点 ID（逗号分隔，留空允许全部节点）</string>
    <string name="remote_agent_all_nodes">允许全部 Tailscale 节点</string>
    <string name="remote_agent_all_keys">全选签名密钥</string>
